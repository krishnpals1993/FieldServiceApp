@model FieldServiceApp.Models.OrderImageViewModel

<div class="modal fade show" style="display:block;z-index: 99999999 !important;">
    <div class="modal-dialog">
        <div class="modal-content ">
            <div class="modal-header">
                <h5 class="modal-title">Share Image With Email</h5>
                <button type="button" class="close close1" onclick="closeModel()">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-orange-d3 text-125 text-center" style="margin-bottom:0px">OrderNo: #@Model.OrderId</p>
                <p class="text-primary text-105 mt-1 text-center" style="margin-bottom:0px">Customer: @Model.CustomerName <br />(@Model.ShipAddress)</p>

                <div class="row">
                    <div class="col-lg-12">
                        <img style="max-width: 470px; margin-top: 50px;" src="data:image/png;base64,@(Convert.ToBase64String(Model.Base64))" class="img-circle" />

                    </div>
                </div>
                <br />
                <p class="text-primary text-105 mt-1 text-center" style="margin-bottom:0px"> @Model.Description </p>

                <div class="m-2">
                    <form class="mt-lg-3" autocomplete="off" enctype="multipart/form-data"
                          novalidate action="AddImage" method="post">
                        <div class="card bcard mt-2 mt-lg-3">

                            <div class="card-body px-3 pb-1">

                                <div class="form-group row">
                                    <div class="col-sm-3 col-form-label text-sm-right pr-0">
                                        <label for="id-form-field-1" class="mb-0">
                                            Email 1
                                        </label>
                                    </div>

                                    <div class="col-sm-9">
                                        <input type="email" id="email1" class="form-control" placeholder="Email 1" />
                                    </div>
                                </div>


                                <div class="form-group row">
                                    <div class="col-sm-3 col-form-label text-sm-right pr-0">
                                        <label for="id-form-field-1" class="mb-0">
                                            Email 2
                                        </label>
                                    </div>

                                    <div class="col-sm-9">
                                        <input type="email" id="email2" class="form-control" placeholder="Email 1" />
                                    </div>
                                </div>


                                <div class="form-group row">
                                    <div class="col-sm-3 col-form-label text-sm-right pr-0">
                                        <label for="id-form-field-1" class="mb-0">
                                            Email 3
                                        </label>
                                    </div>

                                    <div class="col-sm-9">
                                        <input type="email" id="email3" class="form-control" placeholder="Email 1" />
                                    </div>
                                </div>

                                <div class="mt-5 border-t-1 brc-secondary-l2 py-35 mx-n25">
                                    <div class="offset-md-2 col-md-9 text-nowrap">
                                        <button class="btn btn-info btn-bold px-4" type="button" onclick="shareEmail(@Model.JobImageId)">
                                            <i class="fa fa-check mr-1"></i>
                                            Share
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning btn-bold ml-2px close1"
                                                onclick="closeModel()">
                                            Close
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </form>
                </div>


            </div>

        </div>
    </div>
</div>

<style>
    .showSweetAlert {
        z-index: 999999999 !important;
    }

    .sweet-alert {
        z-index: 999999999 !important;
    }

</style>

